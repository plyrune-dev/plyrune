#!/bin/sh
set -eu
sha=$(git rev-parse HEAD)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git archive -o "$work/tree.tar" "$sha"
tar -xf "$work/tree.tar" -C "$work"
cd "$work"
echo "Plyrune fast gate: $sha"
sha256sum -c scripts/profile.sha256
python3 tools/native_reference.py > "$work/native-run.json"
cmp qualification/native-trace.json "$work/native-run.json"
python3 qualification/fixture-vectors.py
sh qualification/scaled/check.sh
cargo +1.98.0 fmt --all -- --check
cargo +1.98.0 build --locked --workspace
python3 qualification/inspect-cli.py "$CARGO_TARGET_DIR/debug/plyrune"
cargo +1.98.0 tauten check --format json
cargo +1.98.0 test --locked --workspace
cargo +1.98.0 test --release --locked -p plyrune-kernel -p plyrune-core
