#!/bin/sh
set -eu
src=/work/plyrune
head=$(git -C "$src" rev-parse HEAD)
git config --global --add safe.directory "$src/.git"
git clone --quiet --no-local "$src" /tmp/plyrune-proof
cd /tmp/plyrune-proof
git checkout --quiet --detach "$head"
cargo +1.98.0 tauten proofs --level full >&2
cat proofs/claims.json
